DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here
# NOTE: currently inert — testnet is driven by config/settings.yaml exchange.testnet
DELTA_TESTNET=true
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- News sources (all optional) ---
# The poller works with no keys at all: RSS (CoinDesk, Cointelegraph, Decrypt)
# needs none. These only add tagged/deduped coverage on top.
# CryptoPanic free tier: https://cryptopanic.com/developers/api/
CRYPTOPANIC_AUTH_TOKEN=
# CoinGecko news is PRO-tier only: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
