[Unit]
Description=FYERS runtime and authentication preflight
After=network-online.target fyers-dashboard.service
Wants=network-online.target

[Service]
Type=oneshot
User=shivank
Group=shivank
WorkingDirectory=/home/shivank/AlgoTrader
EnvironmentFile=/etc/algotrader/fyers.env
Environment=FYERS_ENV_FILE=/etc/algotrader/fyers.env
ExecStart=/home/shivank/AlgoTrader/.venv312/bin/python main.py fyers preflight --json --strict
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
